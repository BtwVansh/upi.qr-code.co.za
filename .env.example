# ---------------------------------------------------------------------------
# UPI Pay QR — environment template
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/upipay?schema=public"

# 32-byte hex keys. Generate each with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_ENCRYPTION_KEY encrypts stored personal data (AES-256-GCM).
# APP_INDEX_KEY produces blind indexes for lookup without decrypting every row.
# Keep both stable: rotating them makes existing encrypted rows unreadable.
APP_ENCRYPTION_KEY=""
APP_INDEX_KEY=""

# Admin console credentials. If ADMIN_PASSWORD is empty, /admin is disabled.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Public origin, used for metadata and links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# UPI Number resolution + beneficiary verification
# ---------------------------------------------------------------------------
# UPI_RESOLUTION_PROVIDER: "none" | "http" | "mock"
#   none  — phone lookup is unavailable; users are asked to enter a UPI ID.
#   http  — authorised provider contract, documented in README.md.
#   mock  — local testing only. Additionally requires UPI_MOCK_PROVIDER=true.
#
# The "http" adapter refuses to activate unless you also assert that you are
# authorised to call the provider by setting the CONFIRM flag to "true".
UPI_RESOLUTION_PROVIDER="none"
UPI_RESOLUTION_API_URL=""
UPI_RESOLUTION_API_KEY=""
UPI_RESOLUTION_CONFIRM_AUTHORIZED="false"

# UPI_VERIFICATION_PROVIDER: "none" | "http" | "mock"
# Optional beneficiary/name enquiry for directly entered UPI IDs.
UPI_VERIFICATION_PROVIDER="none"
UPI_VERIFICATION_API_URL=""
UPI_VERIFICATION_API_KEY=""
UPI_VERIFICATION_CONFIRM_AUTHORIZED="false"

UPI_MOCK_PROVIDER="false"

# ---------------------------------------------------------------------------
# Privacy / retention
# ---------------------------------------------------------------------------
RETENTION_DAYS="30"

# POST /api/maintenance/retention with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
